{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% import _self as helper %}

{% block toolbar %}
    {% if collector.callCount > 0 or collector.requestCount > 0 %}
        {% set icon %}
            <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" data-icon-name="icon-tabler-database" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <ellipse cx="12" cy="6" rx="8" ry="3"/>
                    <path d="M4 6v6a8 3 0 0 0 16 0v-6"/>
                    <path d="M4 12v6a8 3 0 0 0 16 0v-6"/>
                </svg>
            </span>
            <span class="sf-toolbar-value">{{ collector.callCount }}</span>
            <span class="sf-toolbar-info-piece-additional-detail">
                <span class="sf-toolbar-label">in</span>
                <span class="sf-toolbar-value">{{ '%0.2f'|format(collector.duration) }}</span>
                <span class="sf-toolbar-label">ms</span>
            </span>
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>DAL calls</b>
                <span>{{ collector.callCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>DynamoDB requests</b>
                <span>{{ collector.tracingRequests ? collector.requestCount : 'not traced' }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>DAL time</b>
                <span>{{ '%0.2f'|format(collector.duration) }} ms</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: '' }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.callCount == 0 and collector.requestCount == 0 ? 'disabled' }}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" data-icon-name="icon-tabler-database" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <ellipse cx="12" cy="6" rx="8" ry="3"/>
                <path d="M4 6v6a8 3 0 0 0 16 0v-6"/>
                <path d="M4 12v6a8 3 0 0 0 16 0v-6"/>
            </svg>
        </span>
        <strong>DynamoDB</strong>
        {% if collector.callCount > 0 %}
            <span class="count">
                <span>{{ collector.callCount }}</span>
                <span>{{ '%0.0f'|format(collector.duration) }} ms</span>
            </span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <style>
        .dynamo-db-details > summary {
            cursor: pointer;
            user-select: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4em;
            padding: 0.25em 0.5em;
            border-radius: 3px;
            color: var(--color-muted, #666);
        }
        .dynamo-db-details > summary:hover {
            background-color: var(--table-row-hover, rgba(0, 0, 0, 0.05));
        }
        .dynamo-db-details > summary::-webkit-details-marker { display: none; }
        .dynamo-db-details > summary::marker { content: ''; }
        .dynamo-db-details > summary::before {
            content: '▶';
            font-size: 0.75em;
            transition: transform 0.15s ease;
            display: inline-block;
        }
        .dynamo-db-details[open] > summary::before {
            transform: rotate(90deg);
        }
        .dynamo-db-row > td {
            border-bottom: 0;
            padding-bottom: 0.25em;
        }
        .dynamo-db-detail-row > td {
            border-top: 0;
            padding-top: 0;
        }
        .dynamo-db-muted {
            opacity: 0.6;
        }
    </style>

    <h2>DynamoDB</h2>

    {% if not collector.tracingRequests %}
        <div class="alert alert-warning">
            DynamoDB requests are not traced. Route AsyncAws through an HTTP client named <code>aws.base-client</code> to see them.
        </div>
    {% endif %}

    {% if collector.callCount == 0 and collector.requestCount == 0 %}
        <div class="empty">
            <p>No DAL calls were made in this request.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.callCount }}</span>
                <span class="label">DAL calls</span>
            </div>
            {% if collector.tracingRequests %}
                <div class="metric">
                    <span class="value">{{ collector.requestCount }}</span>
                    <span class="label">DynamoDB requests</span>
                </div>
            {% endif %}
            <div class="metric">
                <span class="value">{{ '%0.2f'|format(collector.duration) }} <span class="unit">ms</span></span>
                <span class="label">DAL time</span>
            </div>
        </div>

        <p class="help">
            DAL time is the wall time spent inside the DAL: compiling, serializing, AsyncAws and the network.
            A key read or search counts while it fetches and converts its items, not while the application handles them.
            The first call of a request also opens the connection to DynamoDB.
        </p>

        <h3>Per caller</h3>
        <table>
            <thead>
                <tr>
                    <th>Caller</th>
                    <th class="num">DAL calls</th>
                    {% if collector.tracingRequests %}
                        <th class="num">DynamoDB requests</th>
                    {% endif %}
                    <th class="num">DAL time</th>
                </tr>
            </thead>
            <tbody>
                {% for caller in collector.byCaller %}
                    <tr>
                        <td>{{ helper.caller(caller) }}</td>
                        <td class="num">{{ caller.call_count }}</td>
                        {% if collector.tracingRequests %}
                            <td class="num">{{ caller.request_count }}</td>
                        {% endif %}
                        <td class="num"><strong>{{ '%0.2f'|format(caller.duration_ms) }} ms</strong></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3>DAL calls</h3>
        {% set columns = collector.tracingRequests ? 5 : 4 %}
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Call</th>
                    {% if collector.tracingRequests %}
                        <th class="num">Requests</th>
                    {% endif %}
                    <th class="num">Time</th>
                    <th>Caller</th>
                </tr>
            </thead>
            <tbody>
                {% for call in collector.calls %}
                    <tr class="dynamo-db-row">
                        <td>{{ loop.index }}</td>
                        <td>
                            <strong>{{ call.method }}</strong>
                            <span class="dynamo-db-muted" title="{{ call.entities|join(', ') }}">{{ call.entities|map(entity => entity|split('\\')|last)|join(', ') }}</span>
                        </td>
                        {% if collector.tracingRequests %}
                            <td class="num">{{ call.requests|length }}</td>
                        {% endif %}
                        <td class="num">{{ '%0.2f'|format(call.duration_ms) }} ms</td>
                        <td>
                            {{ helper.caller(call) }}
                            {% if call.caller_file %}
                                <br>
                                <small>{{ call.caller_file|file_link(call.caller_line) }}:{{ call.caller_line }}</small>
                            {% endif %}
                        </td>
                    </tr>
                    {% if call.failure %}
                        <tr class="dynamo-db-detail-row">
                            <td colspan="{{ columns }}" class="status-error">
                                <strong title="{{ call.failure.class }}">{{ call.failure.class|split('\\')|last }}:</strong> {{ call.failure.message }}
                            </td>
                        </tr>
                    {% endif %}
                    {% if call.requests is not empty %}
                        <tr class="dynamo-db-detail-row">
                            <td colspan="{{ columns }}">
                                <details class="dynamo-db-details">
                                    <summary>{{ call.requests|length }} DynamoDB {{ call.requests|length == 1 ? 'request' : 'requests' }}</summary>
                                    {{ helper.requests(call.requests) }}
                                </details>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>

        {% if collector.outsideRequests is not empty %}
            <h3>DynamoDB requests outside the DAL</h3>
            <p class="help">Requests the application sent through AsyncAws directly. Their time is not DAL time.</p>
            {{ helper.requests(collector.outsideRequests) }}
        {% endif %}
    {% endif %}
{% endblock %}

{% macro caller(row) %}
    {% if row.caller_class %}
        <code title="{{ row.caller_class }}">{{ row.caller_class|split('\\')|last }}::{{ row.caller_method }}</code>
    {% elseif row.caller_method %}
        <code>{{ row.caller_method }}()</code>
    {% else %}
        <em>unknown</em>
    {% endif %}
{% endmacro %}

{% macro requests(requests) %}
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Operation</th>
                <th>Table</th>
                <th>Index</th>
                <th class="num">Items</th>
            </tr>
        </thead>
        <tbody>
            {% for request in requests %}
                <tr class="dynamo-db-row">
                    <td>{{ loop.index }}</td>
                    <td><strong>{{ request.operation }}</strong></td>
                    <td><code>{{ request.table ?? '—' }}</code></td>
                    <td>{{ request.index ?? '—' }}</td>
                    <td class="num">
                        {% if request.counted is not null %}
                            {{ request.counted }} <span class="dynamo-db-muted">counted</span>
                        {% else %}
                            {{ request.items ?? '—' }}
                        {% endif %}
                    </td>
                </tr>
                {% if request.error %}
                    <tr class="dynamo-db-detail-row">
                        <td colspan="5" class="status-error">
                            <strong>Error:</strong> {{ request.error }}
                        </td>
                    </tr>
                {% endif %}
                <tr class="dynamo-db-detail-row">
                    <td colspan="5">
                        <details class="dynamo-db-details">
                            <summary>Request payload</summary>
                            {{ profiler_dump(request.payload, maxDepth=4) }}
                        </details>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
