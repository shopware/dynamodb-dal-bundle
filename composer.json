{
    "name": "shopware/dynamodb-dal-bundle",
    "description": "A data abstraction layer for DynamoDB",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "shopware AG",
            "email": "info@shopware.com",
            "role": "Owner"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopware\\DynamodbDalBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shopware\\DynamodbDalBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "async-aws/dynamo-db": "^3.11",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/service-contracts": "^3.5"
    },
    "require-dev": {
        "async-aws/async-aws-bundle": "^1.17",
        "friendsofphp/php-cs-fixer": "^3.95.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.55",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpstan/phpstan-strict-rules": "^2.0.11",
        "phpstan/phpstan-symfony": "^2.0.18",
        "phpunit/phpunit": "^13.2.2",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-client": "^7.3 || ^8.0",
        "symfony/stopwatch": "^7.3 || ^8.0",
        "symfony/uid": "^7.3 || ^8.0",
        "symfony/web-profiler-bundle": "^7.3 || ^8.0",
        "symfony/yaml": "^7.3 || ^8.0"
    },
    "scripts": {
        "ecs": "php-cs-fixer fix --dry-run --diff",
        "ecs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyze --memory-limit=512M -c phpstan.dist.neon",
        "phpunit": "phpunit",
        "phpunit:unit": "@phpunit --testsuite=unit",
        "phpunit:integration": "@phpunit --testsuite=integration"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "keywords": [
        "dynamodb",
        "dal",
        "symfony-bundle",
        "aws"
    ],
    "suggest": {
        "async-aws/async-aws-bundle": "Provides the AsyncAws DynamoDbClient service the DAL clients autowire",
        "symfony/uid": "Enables Symfony Uid (Uuid/Ulid) entity properties",
        "symfony/framework-bundle": "Needed for the profiler panel (DynamoDbDataCollector)",
        "symfony/web-profiler-bundle": "Renders the DynamoDB profiler panel"
    }
}
